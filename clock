<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Creative Clock</title>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <style>
    body {
      background: #101827;
      color: #66e3ff;
      font-family: Arial, sans-serif;
      text-align: center;
      padding-top: 150px;
      transition: background 0.5s, color 0.5s;
    }

    #clock {
      font-size: 60px;
      transition: transform 0.3s, color 0.3s;
    }

    #message {
      font-size: 18px;
    }
  </style>
</head>
<body>
  <h1>My Creative Clock</h1>
  <div id="clock">00:00:00</div>
  <p id="message">Time is moving!</p>

  <script>
    $(document).ready(function () {

      function updateClock() {
        const now = new Date();

        const hours = String(now.getHours()).padStart(2, "0");
        const minutes = String(now.getMinutes()).padStart(2, "0");
        const seconds = String(now.getSeconds()).padStart(2, "0");

        $("#clock").text(`${hours}:${minutes}:${seconds}`);

        // Change the background based on the hour
        if (now.getHours() >= 6 && now.getHours() < 12) {
          $("body").css({
            "background": "#fff3cd",
            "color": "#8a5a00"
          });
          $("#message").text("Good morning");
        } else if (now.getHours() >= 12 && now.getHours() < 18) {
          $("body").css({
            "background": "#ffe0c2",
            "color": "#a33d00"
          });
          $("#message").text("Good afternoon");
        } else {
          $("body").css({
            "background": "#101827",
            "color": "#66e3ff"
          });
          $("#message").text("Good evening");
        }

        // Even seconds: bigger clock
        if (now.getSeconds() % 2 === 0) {
          $("#clock").css("transform", "scale(1.1)");
        } else {
          $("#clock").css("transform", "scale(1)");
        }
      }

      updateClock();
      setInterval(updateClock, 1000);

    });
  </script>

</body>
</html>
