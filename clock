<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>My Clock</title>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        body {
            text-align: center;
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
            padding-top: 150px;
        }

        h1 {
            color: #333;
        }

        #clock {
            font-size: 50px;
            color: blue;
            transition: all 0.3s ease;
        }

        #message {
            font-size: 20px;
        }
    </style>
</head>

<body>

    <h1>My Digital Clock</h1>

    <div id="clock">00:00:00</div>

    <p id="message">Welcome!</p>

    <script>
        // Function to display the current time
        function displayTimeFunction() {

            // Get the current time
            const now = new Date();

            let hours = now.getHours();
            let minutes = now.getMinutes();
            let seconds = now.getSeconds();

            // Add zero before single-digit numbers
            hours = String(hours).padStart(2, "0");
            minutes = String(minutes).padStart(2, "0");
            seconds = String(seconds).padStart(2, "0");

            // Display the time using jQuery
            $("#clock").text(hours + ":" + minutes + ":" + seconds);

            // Creative effect: change color and size
            if (now.getSeconds() % 2 === 0) {
                $("#clock").css({
                    "color": "blue",
                    "font-size": "60px"
                });
            } else {
                $("#clock").css({
                    "color": "hotpink",
                    "font-size": "50px"
                });
            }

            // Change the message based on the time
            if (now.getHours() < 12) {
                $("#message").text("Good morning!");
            } else if (now.getHours() < 18) {
                $("#message").text("Good afternoon!");
            } else {
                $("#message").text("Good evening!");
            }
        }

        // Display the time every second
        displayTimeFunction();
        setInterval(displayTimeFunction, 1000);
    </script>

</body>
</html>
